{
  "family": "photo-gallery-dev-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::711387109786:role/photo-gallery-dev-ecs-task-execution",
  "taskRoleArn": "arn:aws:iam::711387109786:role/photo-gallery-dev-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DJANGO_ALLOWED_HOSTS", "value": "*" },
        { "name": "AWS_STORAGE_BUCKET_NAME", "value": "photo-gallery-dev-images-711387109786" },
        { "name": "AWS_CLOUDFRONT_DOMAIN", "value": "dd83p2n989uqi.cloudfront.net" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "POSTGRES_HOST", "value": "photo-gallery-dev-db.cwdsq2qouvd7.us-east-1.rds.amazonaws.com" },
        { "name": "POSTGRES_PORT", "value": "5432" },
        { "name": "POSTGRES_DB", "value": "photogallery" }
      ],
      "secrets": [
        { "name": "POSTGRES_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:711387109786:secret:photo-gallery-dev-db-credentials-1w3KAw:username::" },
        { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:711387109786:secret:photo-gallery-dev-db-credentials-1w3KAw:password::" },
        { "name": "DJANGO_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:711387109786:secret:photo-gallery-dev-django-secret-key-6SKsSV:SECRET_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/photo-gallery-dev",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
